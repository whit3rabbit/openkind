{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemRequest",
  "type": "object",
  "properties": {
    "model": {
      "description": "Required. `\"jev-latest\"` or a registered model alias.\nWe keep this required even though Phase 0 doesn't dispatch — the\nengine layer in Phase 2 will use it to pick a backend.",
      "type": "string"
    },
    "questions": {
      "description": "Required. Map of user-chosen id → typed question. Keys are NOT sent\nto the model and are NOT used in inference (per spec).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Question"
      }
    },
    "state": {
      "description": "Required. The content to evaluate.",
      "$ref": "#/$defs/State"
    }
  },
  "required": [
    "state",
    "model",
    "questions"
  ],
  "$defs": {
    "ChoiceQuestion": {
      "description": "Pick one option from a set. Spec: <https://docs.typesafe.ai/api#choice>",
      "type": "object",
      "properties": {
        "criteria": {
          "description": "Map of option key → rubric description. **Values may be `null`**\n(\"use null when an option needs no extra detail\").",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "instructions": true
      },
      "required": [
        "instructions",
        "criteria"
      ]
    },
    "NoulCriteria": {
      "description": "Reserved `true`/`false` keys. `r#true` / `r#false` because those are\nkeywords in Rust (and in the JSON spec).",
      "type": "object",
      "properties": {
        "false": {
          "type": "string"
        },
        "true": {
          "type": "string"
        }
      },
      "required": [
        "true",
        "false"
      ]
    },
    "NoulQuestion": {
      "description": "Yes/no question. Returns the probability the answer is yes.\n\nSpec: <https://docs.typesafe.ai/api#noul>",
      "type": "object",
      "properties": {
        "criteria": {
          "description": "Optional descriptions of what a yes and a no mean.\nReserved keys: `true`, `false`.",
          "anyOf": [
            {
              "$ref": "#/$defs/NoulCriteria"
            },
            {
              "type": "null"
            }
          ]
        },
        "instructions": true
      },
      "required": [
        "instructions"
      ]
    },
    "Question": {
      "description": "Tagged union of the three question kinds. The `type` field is the discriminant.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "noul"
            }
          },
          "$ref": "#/$defs/NoulQuestion",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "$ref": "#/$defs/ChoiceQuestion",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "score"
            }
          },
          "$ref": "#/$defs/ScoreQuestion",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ScoreQuestion": {
      "description": "Rate along an ordered rubric. Spec: <https://docs.typesafe.ai/api#score>",
      "type": "object",
      "properties": {
        "criteria": {
          "description": "Ordered array of level descriptions. Must contain at least 2.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instructions": true
      },
      "required": [
        "instructions",
        "criteria"
      ]
    },
    "State": {
      "description": "State to evaluate. Permissive JSON shape: any string, object, or array.",
      "anyOf": [
        {
          "description": "Plain text.",
          "type": "string"
        },
        {
          "description": "Structured object (e.g. `{ \"user\": {...}, \"logs\": [...], \"diff\": \"...\" }`).",
          "type": "object",
          "additionalProperties": true
        },
        {
          "description": "Ordered list (e.g. chat log entries).",
          "type": "array",
          "items": true
        }
      ]
    }
  }
}
