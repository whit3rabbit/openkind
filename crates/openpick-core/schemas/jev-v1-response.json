{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SystemResponse",
  "type": "object",
  "properties": {
    "answers": {
      "description": "One answer per question id. **Required.**",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Answer"
      }
    },
    "model": {
      "description": "The model that performed the evaluation. **Required.**",
      "type": "string"
    },
    "usage": {
      "description": "Required token usage.",
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "model",
    "answers",
    "usage"
  ],
  "$defs": {
    "Answer": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "noul"
            }
          },
          "$ref": "#/$defs/NoulAnswer",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "$ref": "#/$defs/ChoiceAnswer",
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "score"
            }
          },
          "$ref": "#/$defs/ScoreAnswer",
          "required": [
            "type"
          ]
        }
      ]
    },
    "ChoiceAnswer": {
      "description": "`probabilities` is a full distribution (sums to 1) over the criteria keys.\n`confidence` is required (per spec). `f64` for wire-format precision.",
      "type": "object",
      "properties": {
        "choice": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "probabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "required": [
        "choice",
        "probabilities",
        "confidence"
      ]
    },
    "NoulAnswer": {
      "description": "Spec: `noul` is a number 0..1. **No `confidence` field** — Noul answers\ndon't get one per the spec.\n\n`f64` so wire-format precision matches the API spec exactly (a 0.92\ngoing through f32 round-trips to 0.9200000166893005 — wrong).",
      "type": "object",
      "properties": {
        "noul": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "noul"
      ]
    },
    "ScoreAnswer": {
      "description": "`legend` is level-index (string) → level description.\n`probabilities` is keyed by the same index strings. `confidence` required.\n`f64` for wire-format precision.",
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "format": "double"
        },
        "legend": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "probabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "score": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "score",
        "legend",
        "probabilities",
        "confidence"
      ]
    },
    "Usage": {
      "description": "Token usage. **Required** (per spec — ChatGPT plan said `Option<Usage>`,\nthat's wrong).",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    }
  }
}
