                criteria: vec!["Level 1".into(), "".into()],
            }),
        );
        let req = SystemRequest {
            state: State::Text("sample".into()),
            model: "mock".into(),
            questions,
        };
        let err = validate_request(&req).unwrap_err();
        assert!(matches!(
