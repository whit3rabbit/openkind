fn errors_are_send_sync_across_threads() {
    fn assert_send_sync<T: Send + Sync + 'static>() {}
    assert_send_sync::<Error>();
    assert_send_sync::<opendecision_client::ApiError>();
    assert_send_sync::<opendecision_client::RetryPolicy>();
