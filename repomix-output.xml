            .route("/v1/ping", get(echo))
            .layer(middleware::from_fn_with_state(limiter, rate_limit_layer))
            .with_state(());
        for _ in 0..5 {
            let resp = app
                .clone()
                .oneshot(
                    Request::builder()
                        .uri("/v1/ping")
                        .body(Body::empty())
                        .unwrap(),
                )
                .await
                .unwrap();
            assert_eq!(resp.status(), StatusCode::OK);
        }
    }
